[Unit]
Description=niche-harvest dashboard — TV-friendly status page on port 9000
Documentation=https://github.com/ybotman/niche-harvest
After=network-online.target niche-harvest.service
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=narvest
Group=narvest
WorkingDirectory=/home/narvest/niche-harvest
Environment="NODE_ENV=production"
Environment="HOME=/home/narvest"
EnvironmentFile=/home/narvest/niche-harvest/.env

ExecStart=/usr/bin/env bash run.sh --niche=tango dashboard --port=9000

# Light service — much smaller than scheduler. Read-only DB access.
Restart=on-failure
RestartSec=10s
MemoryMax=300M
CPUQuota=100%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nh-dashboard

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# SQLite WAL mode needs to create .wal and .shm sidecar files even on read.
# Without write access to the data dir, DatabaseSync silently fails and
# dashboard returns empty state. Verified 2026-05-01.
ReadWritePaths=/home/narvest/niche-harvest/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
